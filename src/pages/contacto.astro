---
import Layout from "@/layouts/Layout.astro";
import { ContactPageSchema } from "../types/index";
import LocationMap from "@/components/contact/LocationMap.astro";

const url = `${import.meta.env.API_URL}/pages?slug=contacto`;
const res = await fetch(url);
const json = await res.json();
const { data } = ContactPageSchema.safeParse(json[0]);
if (!data) return null;
---

<Layout
  title={data.title.rendered || "Titulo"}
  subtitle={data.acf.subtitle || "Subtitulo"}
  bgImage={data.feature_images.full.url || "."}
>
  <div
    class="text-xl space-y-3 mt-10 lg:mt-0"
    set:html={data.content.rendered}
  />

  <div
    class="grid  grid-cols-1 lg:grid-cols-2 gap-5"
  >
    <LocationMap location={data.acf.location} />
  </div>
</Layout>
