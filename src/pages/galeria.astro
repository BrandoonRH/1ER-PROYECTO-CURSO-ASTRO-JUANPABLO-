---
import Layout from "@/layouts/Layout.astro";
import GalleryGrid from "@/components/gallery/GalleryGrid.astro";
import { BaseWPSchema, GallerySchema } from "../types/index";

const url = `${import.meta.env.API_URL}/pages?slug=galeria`;
const res = await fetch(url);
const json = await res.json();
const { data } = GallerySchema.safeParse(json[0]);

if (!data) return null;

---

<Layout
  title={data.title.rendered || "Titulo"}
  subtitle={data.acf.subtitle || "Subtitulo"}
  bgImage={data.feature_images.full.url || "."}
>
  <GalleryGrid  
    gallery={data.gallery}
  />
</Layout>
