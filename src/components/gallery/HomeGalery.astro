---
import GalleryGrid from "@/components/gallery/GalleryGrid.astro";
import { GallerySchema } from "../../types";

const url = `${import.meta.env.API_URL}/pages?slug=galeria`;
const res = await fetch(url);
const json = await res.json();
const { data } = GallerySchema.safeParse(json[0]);

if (!data) return null;
---

<section class="bg-white px-20 pb-40 max-w-7xl mx-auto -mt-20 relative">
  <h2 class="text-coffee-400 text-center font-black text-lg uppercase after:coffe-icon pb-10">
    Vive la
    <span class="text-coffee-800 text-4xl block">Experiencia</span>
  </h2>
  <GalleryGrid gallery={data.gallery} />
</section>
