---
const navigation = [
  { name: "Inicio", href: "/" },
  { name: "Nosotros", href: "/nosotros/" },
  { name: "Blog", href: "/blog/" },
  { name: "Proceso", href: "/proceso/" },
  { name: "Menú", href: "/menu/" },
  { name: "Galería", href: "/galeria/" },
  { name: "Contacto", href: "/contacto/" },
];
---

<nav class="flex flex-col lg:flex-row items-center gap-3">
  {
    navigation.map((item) => (
      <a href={item.href} class="uppercase text-lg font-bold text-white">
        {item.name}
      </a>
    ))
  }
</nav>
